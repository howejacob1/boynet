# Object files
*.o

# Binaries in root folder
tomenet
tomenet.server
accedit
evilmeta

# Binaries in src folder
src/tomenet
src/tomenet.server
src/accedit
src/evilmeta

# Tolua binary
src/server/tolua

# Preproc binary
src/preproc/preproc

# Data files from a running server
lib/data/*
!lib/data/.gitkeep

# Save files from a running server
lib/save/*
!lib/save/.gitkeep

# banlist.txt from a running server
lib/config/banlist.txt

# Account file
tomenet.acc

# Generated files
src/client/player.pkg
src/client/spells.pkg
src/client/util.pkg
src/client/w_play.c
src/client/w_spells.c
src/client/w_util.c
src/server/player.pkg
src/server/spells.pkg
src/server/util.pkg
src/server/w_play.c
src/server/w_spells.c
src/server/w_util.c
src/common/w_z_pack.c

# TomeNET updater binaries
src/updater/TomeNET-Updater.32b
src/updater/TomeNET-Updater.64b

# User-specific files and character dumps
lib/user/*.tmp
lib/user/*.dna
lib/user/*-death_*.xhtml
lib/user/*-death_*.txt
lib/user/bookmarks.tmp
lib/user/chathist-*.tmp
lib/user/tomenet-messages_*.txt
lib/user/screenshot_*.xhtml

# User-modified configs (character-specific)
# Ignore any .opt or .prf that doesn't match default patterns
lib/user/*.opt
lib/user/*.opt.bak
lib/user/*.prf
lib/user/*.prf.bak
!lib/user/global.opt
!lib/user/global.prf
!lib/user/font-*.prf
!lib/user/pref-*.prf
!lib/user/graf-*.prf
!lib/user/arcade-*.prf
!lib/user/graphics-*.prf
!lib/user/linux_*.prf
!lib/user/options.prf

# Backup and temporary files (global)
*~
*.pre_

# Server stdout log
tomenet-stdout.log
